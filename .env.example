# Copy this file to .env.local and fill in values

# ── SUPABASE ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── ANTHROPIC AI ──────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key

# ── PAYMENTS ──────────────────────────────────
# Paymob (Egypt)
PAYMOB_API_KEY=your-paymob-key
PAYMOB_INTEGRATION_ID_CARD=your-integration-id
PAYMOB_HMAC_SECRET=your-hmac-secret

# Stripe (International)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── APP ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://medcoreai.com
NEXTAUTH_SECRET=your-random-secret-32-chars
NEXTAUTH_URL=https://medcoreai.com

# ── STORAGE ───────────────────────────────────
# Files are stored in Supabase Storage
# Bucket: med-files (private)
# Bucket: avatars (public)

# ── ANALYTICS ────────────────────────────────
# Internal analytics stored in Supabase
# No external analytics service needed

# ── EMAIL ────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@medcoreai.com
